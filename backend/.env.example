# Google Gemma API Key (Obtain from Google AI Studio / Vertex AI)
GEMMA_API_KEY=your_google_gemma_api_key_here

# Gemma Model Designation (e.g. gemma-4-31b-it, gemma-4-26b-a4b-it, gemma-2-9b-it)
GEMMA_MODEL_NAME=gemma-4-31b-it

# API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
